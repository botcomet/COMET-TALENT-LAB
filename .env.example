# COMET Talent Lab — exemple de configuration. NE JAMAIS committer de vraies valeurs (dépôt public).
# Chaque variable est préfixée TALENTLAB_. En production, les secrets viennent du gestionnaire de secrets de Comet.

# --- environnement : dev | test | prod  (prod refuse le mode dev, exige gateway + secrets + PostgreSQL)
TALENTLAB_ENV=dev
TALENTLAB_DATABASE_URL=sqlite:///./data/talentlab.db
# TALENTLAB_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/talentlab
TALENTLAB_DATA_DIR=./data

# --- authentification : dev (comptes fictifs, sans mot de passe) | gateway (en-tête d'identité + secret partagé)
TALENTLAB_AUTH_MODE=dev
# TALENTLAB_GATEWAY_EMAIL_HEADER=X-Comet-User-Email
# TALENTLAB_GATEWAY_SECRET_HEADER=X-Gateway-Secret
# TALENTLAB_GATEWAY_SECRET=<à générer : openssl rand -base64 48>
# TALENTLAB_SESSION_SECRET=<à générer : openssl rand -base64 48>
# TALENTLAB_ENCRYPTION_KEY=<à générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# --- limites d'import
TALENTLAB_MAX_BATCH_SIZE=20
TALENTLAB_MAX_FILE_MB=10
TALENTLAB_MAX_PAGES=40
TALENTLAB_MIN_CHARS=250
TALENTLAB_PROCESSING_MODE=background
TALENTLAB_WORKER_THREADS=4

# --- plateforme de sourcing : valeurs de départ, non universelles ; la syntaxe réelle de Turnover reste à confirmer
TALENTLAB_PLATFORM=turnover
TALENTLAB_PLATFORM_MAX_LENGTH=250
TALENTLAB_RESULT_TARGET_MIN=30
TALENTLAB_RESULT_TARGET_MAX=100
TALENTLAB_RESULT_TOO_BROAD=10000

# --- seuils de présentation
TALENTLAB_VERY_INTERESTING_MIN=96
TALENTLAB_WORK_VIEW_MIN=95

# --- conservation : valeur de départ, NON validée par le DPO
TALENTLAB_RETENTION_DAYS=180

# --- IA optionnelle (none | anthropic). Désactivée par défaut ; fournisseur écrit mais jamais testé en réel.
TALENTLAB_LLM_PROVIDER=none
# TALENTLAB_LLM_API_KEY=
# TALENTLAB_LLM_MODEL=
